# ============================================================
# GEOVISION AI BACKEND — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# Copy this file to .env in backend/ or root and fill in values.
# ============================================================

# ── Google Earth Engine Configuration ───────────────────────
# Google Cloud Project ID associated with your authorized Earth Engine account
EE_PROJECT_ID=your-google-cloud-project-id

# Optional Service Account (Method 2)
# EE_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com
# EE_PRIVATE_KEY_FILE=path/to/private-key.json

# ── Application Settings ────────────────────────────────────
APP_ENV=development
PORT=8000
DEMO_MODE=false
