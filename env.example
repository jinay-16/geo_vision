# ============================================================
# GEOVISION AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# Copy this file to .env and replace placeholders with your values.
# NEVER commit .env or real credentials to GitHub.
# ============================================================

# ── Google Earth Engine Configuration ───────────────────────
# METHOD 1 (Recommended for Local Dev): Earth Engine User Account
# 1. Run: earthengine authenticate
# 2. Enter your Google Cloud Project ID below (registered for Earth Engine access)
EE_PROJECT_ID=your-google-cloud-project-id

# METHOD 2 (Optional for Production): Service Account
# EE_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com
# EE_PRIVATE_KEY_FILE=path/to/private-key.json

# ── Application Settings ────────────────────────────────────
APP_ENV=development
PORT=8000
DEMO_MODE=false
LOG_LEVEL=info
